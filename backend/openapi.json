  "components": {
    "schemas": {
      "AltSourceIn": {
        "properties": {
          "cid": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Cid"
          },
          "source": {
            "$ref": "#/components/schemas/SourceIn"
          }
        },
        "type": "object",
        "required": [
          "cid",
          "source"
        ],
        "title": "AltSourceIn"
      },
      "ClaimIn": {
        "properties": {
          "pair_id": {
            "type": "string",
            "maxLength": 64,
            "title": "Pair Id"
          },
          "device_name": {
            "type": "string",
            "maxLength": 256,
            "title": "Device Name"
          },
          "client_proof": {
            "type": "string",
            "maxLength": 128,
            "title": "Client Proof"
          }
        },
        "type": "object",
        "required": [
          "pair_id",
          "device_name",
          "client_proof"
        ],
        "title": "ClaimIn"
      },
      "ContribIn": {
        "properties": {
          "source": {
            "$ref": "#/components/schemas/SourceIn"
          },
          "imdb_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 16
              },
              {
                "type": "null"
              }
            ],
            "title": "Imdb Id"
          },
          "tmdb_id": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000000000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Tmdb Id"
          },
          "season": {
            "type": "integer",
            "maximum": 9999.0,
            "minimum": 0.0,
            "title": "Season",
            "default": 0
          },
          "episode": {
            "type": "integer",
            "maximum": 9999.0,
            "minimum": 0.0,
            "title": "Episode",
            "default": 0
          },
          "duration_ms": {
            "type": "integer",
            "maximum": 43200000.0,
            "minimum": 60000.0,
            "title": "Duration Ms"
          }
        },
        "type": "object",
        "required": [
