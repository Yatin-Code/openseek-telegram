# OpenSeek local/VPS example. Copy this to <OPENSEEK_DATA_DIR>/.env and protect
# it (mode 0600). Set OPENSEEK_DATA_DIR and OPENSEEK_ENV_FILE in the service
# environment; OPENSEEK_ENV_FILE must point to the copied file.
#
# This default starts local-only. Open the browser dashboard to connect a
# Telegram channel on first run. Local/VPS does not need Supabase.
OPENSEEK_PROFILE=local

# Optional: use a chosen local dashboard secret instead of the random value in
# <OPENSEEK_DATA_DIR>/admin.token. Keep it at least 16 characters.
# OPENSEEK_ADMIN_TOKEN=

# Optional manual channel-mode configuration. The browser setup form can save
# the channel ID, API credentials, and bot token/StringSession for you.
# Uncomment OPENSEEK_POOL_MODE and fill every required field before starting.
#OPENSEEK_POOL_MODE=channel
#OPENSEEK_TELEGRAM_CHANNEL_ID=-1001234567890
#OPENSEEK_TELEGRAM_API_ID=123456
#OPENSEEK_TELEGRAM_API_HASH=
# Use one identity: a bot already added by an administrator, or a local user
# session file. Vercel cannot use a session file; use a bot or StringSession.
#OPENSEEK_TELEGRAM_BOT_TOKEN=
#OPENSEEK_TELEGRAM_SESSION_FILE=/var/lib/openseek/telegram/openseek.session
#OPENSEEK_POOL_CHANNEL_WRITABLE=auto
#OPENSEEK_CONTRIBUTION=0

# Optional contribution relay. On a contributor instance, set LIBRARIAN to the
# relay bot/HTTPS origin. On the relay host, set LIBRARIAN_ENABLED=1 and grant
# its Telegram bot permission to read and post in the shared channel.
#OPENSEEK_LIBRARIAN=@pool_librarian_bot
#OPENSEEK_LIBRARIAN_KEY=
#OPENSEEK_LIBRARIAN_ENABLED=0

# Vercel settings belong in the Vercel project's Production environment, not
# in this local file. See docs/VERCEL.md for Supabase setup and the TLS pin.
# OPENSEEK_PROFILE=vercel
# OPENSEEK_POOL_MODE=channel
# OPENSEEK_ADMIN_TOKEN=<random-owner-secret-at-least-16-characters>
# OPENSEEK_PUBLIC_TLS_PIN=sha256//<deployment-certificate-SPKI-pin>
# OPENSEEK_TELEGRAM_CHANNEL_ID=-1001234567890
# OPENSEEK_TELEGRAM_API_ID=123456
# OPENSEEK_TELEGRAM_API_HASH=<telegram-api-hash>
# OPENSEEK_TELEGRAM_BOT_TOKEN=<bot-token>
# Or use OPENSEEK_TELEGRAM_SESSION=<Telethon-StringSession> instead of a bot token.
# OPENSEEK_SUPABASE_URL=https://<project>.supabase.co
# OPENSEEK_SUPABASE_SERVICE_KEY=<service-role-key-never-use-the-anon-key>
# OPENSEEK_SUPABASE_BUCKET=openseek-staging
# OPENSEEK_POOL_READ_KEY=<long-random-read-key>
# OPENSEEK_POOL_WRITE_KEY=<separate-long-random-write-key>
# CRON_SECRET=<long-random-vercel-cron-secret>
